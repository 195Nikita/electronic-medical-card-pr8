{
  "openapi": "3.1.0",
  "info": {"title": "Laboratory Results Integration API", "version": "0.1.0"},
  "paths": {
    "/lab-results": {
      "post": {
        "summary": "Приём FHIR R4 Bundle с результатами",
        "security": [{"oauth2": ["lab-results.write"]}],
        "parameters": [{"in": "header", "name": "Idempotency-Key", "required": true, "schema": {"type": "string", "minLength": 1}}],
        "requestBody": {"required": true, "content": {"application/fhir+json": {"schema": {"$ref": "#/components/schemas/Bundle"}}}},
        "responses": {
          "201": {"description": "Результаты приняты"},
          "200": {"description": "Повтор запроса с тем же ключом и содержимым"},
          "400": {"description": "Некорректное сообщение"},
          "401": {"description": "Требуется аутентификация"},
          "403": {"description": "Недостаточно прав"},
          "409": {"description": "Ключ уже использован с другим содержимым"},
          "422": {"description": "Не пройдена проверка профиля, пациента или назначения"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {"oauth2": {"type": "oauth2", "flows": {"clientCredentials": {"tokenUrl": "/oauth/token", "scopes": {"lab-results.write": "Передача результатов"}}}}},
    "schemas": {
      "Bundle": {
        "type": "object",
        "description": "Учебная оболочка контракта. Полная проверка FHIR R4 выполняется отдельным валидатором согласованного профиля.",
        "required": ["resourceType", "type", "entry"],
        "properties": {
          "resourceType": {"const": "Bundle"},
          "type": {"const": "collection"},
          "entry": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["resource"], "properties": {"resource": {"type": "object", "required": ["resourceType"], "properties": {"resourceType": {"enum": ["Patient", "ServiceRequest", "DiagnosticReport", "Observation"]}}}}}}
        }
      }
    }
  }
}
